---
profile: moderate

exclude_paths:
  - .cache/
  - .git/
  - .venv/
  - files/cluster-ocp-restore.sh

skip_list:
  # This disaster-recovery playbook intentionally uses shared orchestration
  # variables, including i_understand_this_is_destructive, across roles.
  - var-naming[no-role-prefix]

warn_list:
  - experimental
  - meta-no-tags
